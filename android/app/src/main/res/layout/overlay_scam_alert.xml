<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_card"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Drag Pill Indicator -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_secondary" />

        <!-- Header: Origin Badge & Risk Level -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_danger"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="SMS ALERT"
                android:textColor="@color/danger_red_glow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvProbability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_danger"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="98.4% Scam Risk"
                android:textColor="@color/danger_red_glow"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sender / Origin Line -->
        <TextView
            android:id="@+id/tvSender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="+1 (800) 555-0199"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Warning Headline -->
        <TextView
            android:id="@+id/tvWarningTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⚠️ ScamShield Alert: Suspicious Scam / Phishing Detected"
            android:textColor="@color/danger_red_glow"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Message Body Preview -->
        <TextView
            android:id="@+id/tvMessagePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#20000000"
            android:ellipsize="end"
            android:maxLines="3"
            android:padding="8dp"
            android:text="URGENT: Your Chase bank account has been locked. Verify immediately at http://chase-security-verify.com"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Privacy Assurance Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🔒 Verified 100% On-Device by Mobile Transformer"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDismiss"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/action_dismiss"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnViewSafely"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/action_view_safely"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnBlock"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_button_danger"
                android:text="@string/action_block"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
